{
    "name": "hltv.js",
    "version": "1.0.0",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/types/index.d.ts",
    "scripts": {
        "util:build": "bun run eslint:lint && bun run prettier:format && bun run ts:compile",
        "eslint:lint": "eslint .",
        "prettier:format": "prettier . --write",
        "ts:compile": "tsc --project tsconfig.cjs.json && tsc --project tsconfig.esm.json",
        "doc:generate": "typedoc --plugin typedoc-plugin-missing-exports"
    },
    "devDependencies": {
        "@types/bun": "^1.4.4",
        "@types/jest": "^30.0.0",
        "@types/user-agents": "^1.0.4",
        "@types/xml2js": "^0.4.14",
        "axios-mock-adapter": "^2.1.0",
        "globals": "^17.13.0",
        "jest": "^30.5.2",
        "prettier": "3.9.10",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typedoc": "^0.28.20",
        "typedoc-plugin-missing-exports": "^4.1.4",
        "typescript": "7.0.2",
        "typescript-eslint": "^8.73.0"
    },
    "peerDependencies": {
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@eslint/js": "^10.0.1",
        "axios": "^1.21.1",
        "eslint": "^10.15.0",
        "user-agents": "^2.1.258",
        "xml2js": "^0.6.2"
    }
}
